# Copy this file to .env and fill in the two values from your Supabase project:
# Supabase dashboard -> Project Settings -> Data API  (and -> API Keys for the anon key)
#
# Both of these are PUBLIC values. They ship inside the JavaScript bundle and that
# is by design — Row Level Security in supabase/schema.sql is what actually protects
# your data. Never put the service_role key in this file.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# The only email allowed into /admin. Must match the owner_email in schema.sql.
VITE_ADMIN_EMAIL=xainulabideen600@gmail.com
